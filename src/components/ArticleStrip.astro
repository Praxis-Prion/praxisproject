---
// praxisproject/src/components/ArticleStrip.astro
import { Image } from "astro:assets";

interface Props {
  url: string;
  title: string;
  description: string;
  pubDate: Date;
  image?: { url: ImageMetadata; alt: string };
  tags: string[];
}

const { url, title, description, pubDate, image, tags } = Astro.props;
---

<a href={url} class="article-strip">
  {
    image && (
      <div class="article-strip-image">
        <Image src={image.url} alt={image.alt} />
      </div>
    )
  }
  <div class="article-strip-body">
    <span class="article-strip-date">
      {pubDate.toLocaleDateString()}
    </span>
    <h2>{title}</h2>
    <p>{description}</p>
    <div class="article-strip-tags">
      {tags.map((tag) => <span class="article-tag">{tag}</span>)}
    </div>
  </div>
</a>

<style>
  .article-strip {
    display: flex;
    gap: 1.25rem;
    text-decoration: none;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 1) -200%,
      var(--post-card),
      rgba(0, 0, 0, 1) 300%
    );
    border: 1px solid var(--post-border);
    border-radius: 10px;
    overflow: hidden;
    transition:
      border-color 0.2s,
      transform 0.2s;
    align-items: center;
  }

  .article-strip:hover {
    border-color: var(--blue-bright);
    transform: translateX(4px);
  }

  .article-strip-image {
    flex-shrink: 0;
    width: 140px;
  }

  .article-strip-image img {
    width: 140px;
    height: 100%;
    min-height: 120px;
    object-fit: cover;
    display: block;
  }

  .article-strip-body {
    padding: 1rem 1rem 1rem 0;
    flex: 1;
    min-width: 0;
  }

  .article-strip-date {
    font-family: var(--mono);
    font-size: 0.65rem;
    color: var(--post-text-muted);
    display: block;
    margin-bottom: 0.35rem;
  }

  .article-strip-body h2 {
    font-family: var(--mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--post-text);
    line-height: 1.25;
    margin-bottom: 0.5rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .article-strip-body p {
    font-size: 0.85rem;
    color: var(--post-text-sec);
    line-height: 1.5;
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .article-strip-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .article-tag {
    font-family: var(--mono);
    font-size: 0.75rem;
    background: var(--blue-dim);
    color: var(--blue-bright);
    border: 1px solid var(--post-border);
    border-radius: 4px;
    padding: 0.25rem 0.5rem;
  }

  @media (max-width: 768px) {
    .article-strip-image {
      width: 100px;
    }

    .article-strip-image img {
      width: 100px;
      min-height: 100px;
    }
  }
</style>
