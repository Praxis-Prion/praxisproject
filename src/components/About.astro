---
// /sites/praxisproject/src/components/About.astro

import { Image } from "astro:assets";
import profilePhoto from "../assets/aboutMe.webp";
---

<section id="about">
  <div class="about-inner">
    <div class="section-content">
      <div class="about-grid">
        <div class="about-text">
          <span class="eyebrow">// this is me</span>
          <h2>About</h2>
          <p>
            I'm Chris. You could call me a jack-of-all-trades. I've been an ICU
            nurse since 2011. I'm a tech enthusiast into homelabbing/self-hosting.
            I picked up woodworking during the covid era, and make furniture and things
            around the house.
          </p>
          <p>
            I built this site to share stories about projects and other things with people.
          </p>
        </div>
        <div class="about-photo">
          <Image src={profilePhoto} alt="test image" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #about {
    background-image: url("../assets/bg-wood.webp");
    background-color: var(--bg-surface);
    /* top right until a portrait background is made */
    background-position: top right;
    /* scroll-margin-top: calc(var(--section-gap) - 223px); */
  }

  .about-inner {
    position: relative;
    z-index: 1;
    /* background-color: var(--bg-surface); */
    background: linear-gradient(
      to right,
      rgba(0, 0, 0, 1) -100%,
      var(--bg-surface),
      rgba(0, 0, 0, 1) 200%
    );
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .about-grid {
      gap: 4rem;
    }
  }

  .about-text h2 {
    font-family: var(--mono);
    font-size: clamp(1.6rem, 4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 1.5rem;
  }

  .about-text p {
    color: var(--text-sec);
    margin-bottom: 1.25rem;
  }

  .about-photo {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .about-photo img {
    width: auto;
    height: 400px;
    max-width: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
