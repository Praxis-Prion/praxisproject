---
// /sites/praxisproject/src/components/HeaderSearch.astro
import Search from "astro-pagefind/components/Search";
---
<div class="search">
  <Search id="search" className="pagefind-ui" uiOptions={{ showImages: false }} />
</div>

<style is:global>
  .search {
    display: none;
    position: relative;
    margin: 0px;
    padding: 0px;
  }

  .pagefind-ui {
    position: relative;
    /* --pagefind-ui-scale: 0.5; */
    /* --pagefind-ui-font: sans-serif; */
    /* font-size: 1rem !important; */
    /* --pagefind-ui-primary: navy; */
    /* --pagefind-ui-text: black; */
    /* --pagefind-ui-border: slategrey; */
    /* --pagefind-ui-border-width: 1px; */
    /* --pagefind-ui-border-radius: 0.25rem; */
    /* --pagefind-ui-font: sans-serif; */
    /* width: 50%; */
  }

  .pagefind-ui .pagefind-ui__drawer:not(.pagefind-ui__hidden) {
    position: absolute;
    /* max-height: calc(100vh - 33vh); */
    overflow-y: auto;
    padding: 0rem 0.5rem;
    padding-bottom: 2rem;
    overscroll-behavior: contain;
    background: white;
    width: 100vw;
    right: 0;
    top: 100%;
    border-radius: 8px;
    box-shadow: -5px 5px 10px rgba(0,0,0,0.25);
    z-index: 1000;
  }

  .pagefind-ui .pagefind-ui__result-link {
    /* color: red !important; */
  }

  .pagefind-ui .pagefind-ui__result-excerpt {
    /* color: red; */
  }

  @media screen and (min-width: 768px) {
    .pagefind-ui__form .pagefind-ui__search-input {
      height: 40px !important;
      right: 3px
      /* font-size: 2rem; */
    }

    .pagefind-ui .pagefind-ui__drawer:not(.pagefind-ui__hidden) {
      right: 0;
    }

    .search {
      display: block;
      margin-left: auto;
    }

    .pagefind-ui__form::before {
      top: 50% !important;
      transform: translateY(-50%);
    }

    .pagefind-ui__search-clear {
      top: 50% !important;
      transform: translateY(-50%) !important;
      height: auto !important;
    }
  }

</style>

<script>
  import "../scripts/search.js";
</script>