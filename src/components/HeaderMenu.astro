---
// /sites/praxisproject/src/components/HeaderMenu.astro
---
<div class="menu">
  <button aria-expanded="false" aria-controls="main-menu" class="menu-button">
    <span></span>
    <span></span>
    <span></span>
  </button>
</div>

<style>
  .menu {
  }

  /* controls .nav visibility when menu is open */
  :global(:has(.menu-button[aria-expanded="true"]) .nav) {
    display: block;
    width: 100%;
    order: 99;
    text-align: center;
  }

  /* controls .search visibility when menu is open */
  :global(:has(.menu-button[aria-expanded="true"]) .search) {
    display: block;
    width: 100%;
    order: 100;
  }

  .menu-button {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 0px 10px;
  }

  .menu-button span {
    display: block;
    width: 25px;
    height: 3px;
    background-color: white;
    border-radius: 3px;
  }

  @media screen and (min-width: 768px) {
    .menu {
      display: none;
    }
  }
</style>