---
// /sites/praxisproject/src/components/Hero.astro
---

<section id="hero" class="hero-init">
  <div class="hero-inner">
    <div class="section-content">
      <span class="eyebrow">welcome</span>
      <h1>
        Praxis<br /><span class="accent"
          >Project<span class="accent-cursor">_</span></span
        >
      </h1>
      <p class="hero-desc">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. In accumsan
        aliquet purus, vitae hendrerit orci dignissim non.
      </p>
      <div class="btn-row">
        <a href="/articles" class="btn btn-primary">Read Articles</a>
        <a href="#about" class="btn btn-outline">About Me</a>
      </div>
    </div>
  </div>
</section>

<style>
  #hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background-image: url("../assets/bg.webp");
    background-color: var(--bg-surface);
    padding: clamp(2rem, 8vh, 15rem) 0;
    padding-bottom: 15rem;
  }

  /* overlay for hero background if needed */
  #hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Initial hidden state BEFORE animation */
  .hero-init h1,
  .hero-init .hero-desc,
  .hero-init .btn-row,
  .hero-init .accent,
  .hero-init .accent-cursor,
  .hero-init .eyebrow {
    opacity: 0;
  }

  .hero-inner {
    position: relative;
    width: 100%;
    background-color: var(--bg-surface);
    z-index: 1;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .hero-inner::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      150% 50% at 25% 40%,
      rgba(59, 130, 246, 0.08) 0%,
      transparent 50%
    );
  }

  #hero .eyebrow {
    animation: fadeRight 1s ease forwards;
    margin-left: -25px;
  }

  #hero .eyebrow::before {
    content: "";
    display: block;
    width: 100px;
    height: 1px;
    background: linear-gradient(
      to left,
      var(--blue-bright) 0%,
      transparent 100%
    );
  }

  h1 {
    opacity: 0;
    text-shadow: 0px 0px 10px rgba(0, 0, 0, 0.75);
    animation: fadeUp 0.7s ease forwards;
  }

  h1 .accent {
    color: var(--blue-bright);
    opacity: 0;
    animation: fadeUp 0.7s ease forwards;
  }

  .hero-desc {
    opacity: 0;
    font-size: 1.1rem;
    color: var(--text-sec);
    max-width: 500px;
    margin-bottom: 3rem;
    line-height: 1.8;
    text-shadow: 0px 0px 10px rgba(0, 0, 0, 0.75);
    animation: fadeUp 0.85s ease forwards;
  }

  .btn-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    animation: fadeUp 1s ease forwards;
  }

  .accent-cursor {
    opacity: 0;
    animation: flash 1s steps(1) infinite;
  }

  @keyframes flash {
    0%,
    100% {
      opacity: 0;
    }

    50% {
      opacity: 1;
    }
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeRight {
    from {
      opacity: 0;
      transform: translateY(0);
    }
    to {
      opacity: 1;
      transform: translateX(25px);
    }
  }
</style>
