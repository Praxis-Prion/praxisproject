---
// /sites/praxisproject/src/components/Hero.astro
---

<section id="hero">
  <div class="hero-inner">
    <div class="section-content">
      <span class="eyebrow">welcome</span>
      <h1>
        Praxis<br /><span class="accent"
          >Project<span class="accent-cursor">_</span></span
        >
      </h1>
      <p class="hero-desc">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. In accumsan
        aliquet purus, vitae hendrerit orci dignissim non.
      </p>
      <div class="btn-row">
        <a href="#posts" class="btn btn-primary">Read Articles</a>
        <a href="#about" class="btn btn-outline">About Me</a>
      </div>
    </div>
  </div>
</section>

<style>
  #hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* overflow: hidden; */
    background-image: url("../assets/bg.webp");
    background-color: var(--bg-surface);
    padding: var(--section-gap) 0;
  }

  #hero::before {
    content: "";
    position: absolute;
    inset: 0;

    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    width: 100%;
    background-color: var(--bg-surface);
    z-index: 1;
  }

  .hero-inner::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      150% 50% at 25% 40%,
      rgba(59, 130, 246, 0.08) 0%,
      transparent 50%
    );
  }

  #hero .eyebrow::before {
    content: "";
    display: block;
    width: 100px;
    height: 1px;
    background: linear-gradient(
      to left,
      var(--blue-bright) 0%,
      transparent 100%
    );
  }

  h1 {
    text-shadow: 0px 0px 10px rgba(0,0,0,0.75);
  }

  .hero-desc {
    font-size: 1.1rem;
    color: var(--text-sec);
    max-width: 500px;
    margin-bottom: 3rem;
    line-height: 1.8;
    text-shadow: 0px 0px 10px rgba(0,0,0,0.75);
  }

  .btn-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 500;
    text-decoration: none;
    padding: 0.7rem 1.6rem;
    border-radius: 6px;
    letter-spacing: 0.04em;
    transition: all 0.2s;
  }

  .btn-primary {
    background: var(--blue);
    color: #fff;
    border: 1px solid var(--blue);
  }

  .btn-primary:hover {
    background: var(--blue-bright);
    border-color: var(--blue-bright);
  }

  .btn-outline {
    background: transparent;
    color: var(--text-sec);
    border: 1px solid var(--border-hover);
  }

  .btn-outline:hover {
    color: var(--text);
    border-color: var(--blue-bright);
  }

  .accent-cursor {
    animation: flash 1s steps(1) infinite;
  }

  @keyframes flash {
    0%,
    100% {
      opacity: 0;
    }

    50% {
      opacity: 1;
    }
  }
</style>
