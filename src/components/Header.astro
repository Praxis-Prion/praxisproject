---
// /sites/praxisproject/src/components/Header.astro
import HeaderMenu from '../components/HeaderMenu.astro';
import HeaderNav from '../components/HeaderNav.astro';
import HeaderSearch from '../components/HeaderSearch.astro';
// import { Image } from 'astro:assets';
// import logo from '../assets/logo.png';
---
<header data-pagefind-ignore>
  <div class="logo">
    <!-- <a href="/"><Image src={logo} alt="Praxis Project" /></a> -->
    <span><a href="/">Praxis Project</a></span>
  </div>
  <HeaderMenu />
  <HeaderNav />
  <HeaderSearch />
</header>

<style>
  header {
    display: flex;
    position: sticky;
    top: 0;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px); /* Safari */
    background-color: rgba(0, 0, 50, 0.5);
    align-items: center;
    flex-wrap: wrap;
    box-shadow: 0 5px 10px rgba(0,0,0,0.25);
    border-bottom: 1px solid black;
    z-index: 1000;
  }

  .logo {
    display: flex;
  }

  .logo span{
    /* height: 50px; */
    font-size: 2rem;
    font-weight: bold;
    padding-left: 5px;
    padding-top: 5px;
    transition: filter 0.5s ease, transform 0.5s ease;
  }

  .logo span:hover {
    filter: drop-shadow(0 0 8px rgba(255, 150, 100, 0.5));
    transform: scale(1.01);
  }

  .logo a {
    color: #cfcfcf;
    display: flex;
    text-decoration: none;
  }
</style>