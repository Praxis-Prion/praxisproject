import HeaderMenu from '../components/HeaderMenu.astro';
import HeaderNav from '../components/HeaderNav.astro';
import HeaderSearch from '../components/HeaderSearch.astro';
---
<header>
  <div class="title">
    <h1>Praxis Project</h1>
  </div>
  <HeaderMenu />
  <HeaderNav />
  <HeaderSearch />
</header>

<style>
  header {
    background-color: cyan;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .title {
    margin-right: auto;
  }
</style>