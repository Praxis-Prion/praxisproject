---
// /sites/praxisproject/src/components/Tags.astro
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");

// Add a counter for how many posts there are per tag
const tagCounts = allPosts
  .flatMap((post) => post.data.tags)
  .reduce(
    (acc, tag) => {
      acc[tag] = (acc[tag] || 0) + 1;
      return acc;
    },
    {} as Record<string, number>,
  );

// Adds a size class to tags depending on number of post breakpoints
const getTier = (count: number) => {
  if (count >= 6) return "xl";
  if (count >= 4) return "lg";
  if (count >= 2) return "md";
  return "sm";
};

// Sort posts by highest number of posts in a tag first, then alphabetically
const tags = Object.entries(tagCounts).sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);
---

<section id="tags">
  <div class="tags-inner">
    <div class="section-content">
      <span class="eyebrow">// topics</span>
      <h2>Browse Posts by Tag</h2>
      <div class="tags-cloud">
        {
          tags.map(([tag, count]) => (
            <a
              href={`/tags/${tag}/`}
              class={`tag-pill tag-pill--${getTier(count)}`}
            >
              {tag} <span class="tag-count">{count}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  #tags {
    background-image: url("../assets/bg.webp");
    background-color: var(--bg-surface);
  }

  .tags-inner {
    position: relative;
    z-index: 1;
    background-color: var(--bg-surface);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
    align-items: flex-end;

  }

  .tag-pill {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    background: var(--bg-card);
    color: var(--text-sec);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.4rem 0.9rem;
    text-decoration: none;
    transition:
      color 0.2s,
      border-color 0.2s,
      background 0.2s;
  }

  .tag-pill:hover {
    color: var(--blue-bright);
    border-color: var(--border-hover);
    background: var(--blue-dim);
  }

  .tag-count {
    color: var(--text-muted);
    font-size: 0.65rem;
    margin-left: 0.25rem;
  }

  .tag-pill--sm {
    font-size: 0.72rem;
    padding: 0.35rem 0.75rem;
    color: var(--text-muted);
    border-color: var(--border);
  }

  .tag-pill--md {
    font-size: 0.85rem;
    padding: 0.4rem 0.9rem;
    color: var(--text-sec);
    border-color: var(--border);
  }

  .tag-pill--lg {
    font-size: 0.95rem;
    padding: 0.45rem 1rem;
    color: var(--text);
    border-color: var(--border-hover);
  }

  .tag-pill--xl {
    font-size: 1.1rem;
    padding: 0.5rem 1.1rem;
    color: var(--blue-bright);
    border-color: var(--blue);
  }
</style>
