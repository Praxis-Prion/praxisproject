---
// /sites/praxisproject/src/components/Card.astro
const { linkCard = false } = Astro.props;
---

<div class={`card ${linkCard ? "card-link" : ""}`}>
  <slot />
</div>

<style>
  /* ========================
   Base card
   ======================== */
  .card {
    background-color: rgba(225, 225, 255, 0.5);
    padding: 20px;
    border-radius: 10px;
    border: 1px solid black;
    box-shadow: 0 5px 10px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    margin-top: 1rem;
    break-inside: avoid;
    line-height: 1.5;
  }

  /* ========================
   Card typography
   ======================== */

  :global(.card h1),
  :global(.card h2),
  :global(.card h3),
  :global(.card h4),
  :global(.card h5),
  :global(.card h6) {
    line-height: 1.25;
  }

  :global(.card li) {
    margin-left: 1rem;
  }

  /* ========================
   Card links and images
   ======================== */

  /* global link style inside cards */
  :global(.card a) {
    text-decoration: none;
    color: blue;
  }

  :global(.card a img) {
    border-radius: 8px;
  }

  :global(.card a img:hover) {
    cursor: pointer;
  }

  :global(.card .tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  :global(.card img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  /* mobile: markdown images full width */
  :global(.card .float-left),
  :global(.card .float-right) {
    float: none;
    max-width: 100%;
    margin: 0 0 1rem 0;
  }

  /* desktop: float images left or right with text wrap */
  @media screen and (min-width: 768px) {
    :global(.card .float-left) {
      float: left;
      max-width: 45%;
      margin: 0 1rem 1rem 0;
    }

    :global(.card .float-right) {
      float: right;
      max-width: 45%;
      margin: 0 0 1rem 1rem;
    }
  }

  /* ========================
   Link card variant - used for article/tag index cards
   ======================== */

  /* remove card padding so the <a> tag covers the full clickable area */
  :global(.card-link) {
    padding: 0;
    overflow: hidden;
  }

  /* <a> becomes the padding container so entire card is clickable */
  :global(.card-link a) {
    display: block;
    padding: 20px;
  }

  /* sets card title height */
  :global(.card-link h3) {
    height: calc(1.5rem * 3);
    overflow: hidden;
    margin-bottom: 0.5rem;
  }

  /* sets card description height */
  :global(.card-link p) {
    height: calc(1.5rem * 5);
    overflow: hidden;
  }

  /* card date */
  :global(.card-link span) {
    color: #636363;
  }

  /* card description */
  :global(.card-link a p) {
    color: #636363;
  }

  /* card title */
  :global(.card-link h3) {
    color: #303030;
  }
</style>
