---
// /sites/praxisproject/src/components/Card.astro
const { linkCard = false } = Astro.props;
---
<div class={`card ${linkCard ? 'card-link' : ''}`}>
  <slot />
</div>

<style>
/* ========================
   Base card
   ======================== */
.card {
  background-color: rgba(200, 200, 255, 0.25);
  padding: 20px;
  border-radius: 10px;
  border: 1px solid black;
  box-shadow: 0 5px 10px rgba(0,0,0,0.25);
  backdrop-filter: blur(3px);
  -webkit-backdrop-filter: blur(3px);
  margin-top: 1rem;
  break-inside: avoid;
}

/* ========================
   Card typography
   ======================== */
:global(.post-content h2),
:global(.post-content h3),
:global(.post-content p),
:global(.post-content ul),
:global(.post-content ol) {
  padding-bottom: 1rem;
}

:global(.post-content h1),
:global(.post-content h2) {
  padding-top: 1.5rem;
}

:global(.card li) {
  margin-left: 1rem;
}

/* ========================
   Card links and images
   ======================== */
:global(.card a) {
  text-decoration: none;
  color: blue;
}

:global(.card a img) {
  border-radius: 8px;
  transition: opacity 0.2s ease;
}

:global(.card a img:hover) {
  cursor: pointer;
}

:global(.card .tags) {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

:global(.card img) {
  max-width: 100%;
  height: auto;
  border-radius: 8px;
}

:global(.card .float-left),
:global(.card .float-right) {
  float: none;
  max-width: 100%;
  margin: 0 0 1rem 0;
}

@media screen and (min-width: 768px) {
  :global(.card .float-left) {
    float: left;
    max-width: 45%;
    margin: 0 1rem 1rem 0;
  }

  :global(.card .float-right) {
    float: right;
    max-width: 45%;
    margin: 0 0 1rem 1rem;
  }
}

/* ========================
   Link card variant
   ======================== */
.card-link {
  padding: 0;
  overflow: hidden;
}

:global(.card-link a) {
  display: block;
  padding: 20px;
}

:global(.card-link h3) {
  height: calc(1.4rem * 3);
  overflow: hidden;
  margin-bottom: 0.5rem;
}

:global(.card-link p) {
  height: calc(1.2rem * 5);
  overflow: hidden;
}

:global(.card-link span) {
  color: black;
}

:global(.card-link a p) {
  color: black;
}
</style>