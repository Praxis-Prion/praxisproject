---
// /sites/praxisproject/src/components/Card.astro
---
<div class="card">
  <slot />
</div>

<style>
  .card {
    background-color: rgba(200, 200, 255, 0.25);
    padding: 20px;
    border-radius: 10px;
    border: 1px solid black;
    box-shadow: 0 5px 10px rgba(0,0,0,0.25);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    margin-top: 1rem;
  }

 :global(.card li) {
    margin-left: 15px;
  }
</style>