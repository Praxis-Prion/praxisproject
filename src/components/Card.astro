---
// /sites/praxisproject/src/components/Card.astro
---
<div class="card">
  <slot />
</div>

<style>
  .card {
    background-color: rgba(200, 200, 255, 0.25);
    padding: 20px;
    border-radius: 10px;
    border: 1px solid black;
    box-shadow: 0 5px 10px rgba(0,0,0,0.25);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    margin-top: 1rem;
  }

  :global(.card h1),
  :global(.card h2),
  :global(.card h3),
  :global(.card p),
  :global(.card ul),
  :global(.card ol) {
    margin-bottom: 1rem;
  }

  :global(.card h1),
  :global(.card h2),
  :global(.card h3) {
    margin-top: 1.5rem;
  }

  :global(.card li) {
    margin-left: 1.5rem;
  }

  :global(.card a img) {
    border-radius: 8px;
    transition: opacity 0.2s ease;
  }

  :global(.card a img:hover) {
    /* opacity: 0.85; */
    cursor: pointer;
  }

  :global(.card .tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  :global(.card a) {
    text-decoration: none;
    color: blue;
  }
</style>