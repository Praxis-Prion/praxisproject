---
// /sites/praxisproject/src/pages/tags/index.astro
import { getCollection } from "astro:content";
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Tag Index";
// Get all posts and extract a deduplicated flat array of every tag used across all posts
const allPosts = await getCollection("blog");
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())].sort();
---
<BaseLayout pageTitle={pageTitle} pagefindIgnore={true}>
  <div class="tags">
    {tags.map((tag) => (
      <Card><p class="tag"><a href={`/tags/${tag}`}>{tag}</a></p></Card>
    ))}
  </div>
</BaseLayout>

