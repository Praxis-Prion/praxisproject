---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const uniqueTags = [
    ...new Set(allPosts.map((post) => post.data.tags).flat()),
  ].sort();
  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts
      .filter((post) => post.data.tags.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return { params: { tag }, props: { posts: filteredPosts } };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
const currentTag = tag;
const pageTitle = `#${tag}`;

const allPosts = await getCollection("blog");

const tagCounts = allPosts
  .flatMap((post) => post.data.tags)
  .reduce(
    (acc, tag) => {
      acc[tag] = (acc[tag] || 0) + 1;
      return acc;
    },
    {} as Record<string, number>,
  );

const tags = Object.entries(tagCounts).sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);
---

<BaseLayout pageTitle={pageTitle} pagefindIgnore={true} bodyClass="tag-body">
  <div class="tag-page">
    <div class="tags-cloud">
      {
        tags.map(([t, count]) => (
          <a
            href={`/tags/${t}/`}
            class={`tag-pill ${t === currentTag ? "tag-pill--active" : ""}`}
          >
            {t} <span class="tag-count">{count}</span>
          </a>
        ))
      }
    </div>
    <h1 class="tag-heading">
      <span class="tag-accent">Posts tagged with:</span> #{tag}
    </h1>
    <p class="tag-subheading">
      {posts.length}
      {posts.length === 1 ? "post" : "posts"}
    </p>
    <div class="tag-posts">
      {
        posts.map((post) => (
          <a href={`/posts/${post.id}/`} class="tag-post-card">
            {post.data.image && (
              <div class="tag-post-image">
                <Image src={post.data.image.url} alt={post.data.image.alt} />
              </div>
            )}
            <div class="tag-post-body">
              <span class="tag-post-date">
                {post.data.pubDate.toLocaleDateString()}
              </span>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  body.tag-body {
    background-image: url("../../assets/bg.webp");
    background-size: cover;
    background-attachment: fixed;
    background-position: center;
  }

  .tag-page {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 4rem 2rem;
    background-color: var(--bg-surface);
  }

  .tag-heading {
    font-family: var(--mono);
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--blue-bright);
    margin-bottom: 0.5rem;
    margin-top: 2rem;
  }

  .tag-accent {
    color: white;
  }

  .tag-subheading {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
  }

  .tag-posts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .tag-posts {
      grid-template-columns: 1fr 1fr;
    }
  }

  .tag-post-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }

  .tag-post-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-3px);
  }

  .tag-post-image img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    display: block;
  }

  .tag-post-body {
    padding: 1.25rem;
  }

  .tag-post-date {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    display: block;
    margin-bottom: 0.5rem;
  }

  .tag-post-body h2 {
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.4;
    margin-bottom: 0.5rem;
  }

  .tag-post-body p {
    font-size: 0.85rem;
    color: var(--text-sec);
    line-height: 1.65;
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
    align-items: flex-end;
  }

  .tag-pill {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    background: var(--bg-card);
    color: var(--text-sec);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.4rem 0.9rem;
    text-decoration: none;
    transition:
      color 0.2s,
      border-color 0.2s,
      background 0.2s;
  }

  .tag-pill:hover {
    color: var(--blue-bright);
    border-color: var(--border-hover);
    background: var(--blue-dim);
  }

  .tag-pill--active {
    font-size: 1.1rem;
    padding: 0.5rem 1.1rem;
    color: var(--blue-bright);
    border: 1px solid var(--blue);
    background: var(--blue-dim);
  }

  .tag-count {
    color: var(--text-muted);
    font-size: 0.65rem;
    margin-left: 0.25rem;
  }
</style>
