---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Related posts — project first, then tag overlap
const allPosts = await getCollection("blog");
const otherPosts = allPosts.filter((p) => p.id !== post.id);

const scoredPosts = otherPosts
  .map((p) => {
    const sameProject =
      post.data.project && p.data.project === post.data.project;
    const sharedTags = p.data.tags.filter((t) =>
      post.data.tags.includes(t),
    ).length;
    return { post: p, score: (sameProject ? 1000 : 0) + sharedTags };
  })
  .sort((a, b) => b.score - a.score)
  .slice(0, 4);

const relatedPosts = scoredPosts.map((s) => s.post);

// Theme → bodyClass
const bodyClass = post.data.theme ? `theme-${post.data.theme}` : "";
---

<BaseLayout pageTitle={post.data.title} bodyClass={bodyClass}>
  <div class="post-page">
    <!-- Post header -->
    <div class="post-header">
      {
        post.data.image && (
          <div class="post-hero-image">
            <a href={post.data.image.url.src} target="_blank">
              <Image src={post.data.image.url} alt={post.data.image.alt} />
            </a>
          </div>
        )
      }
      <div class="post-header-content">
        <h1 id="post-title">{post.data.title}</h1>
        <div class="post-meta">
          <span class="post-date">{post.data.pubDate.toLocaleDateString()}</span
          >
          by<span class="post-author"
            ><a href="/#about">{post.data.author}</a></span
          >
        </div>
        <div class="post-tags">
          {
            post.data.tags.map((tag: string) => (
              <a href={`/tags/${tag}/`} class="tag-pill">
                {tag}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Mobile TOC -->
    {
      headings.length > 0 && (
        <details class="toc-mobile">
          <summary>Table of contents</summary>
          <nav class="toc-nav">
            <a href="#post-title" class="toc-link toc-depth-1 toc-link--active">
              {post.data.title}
            </a>
            {headings.map((h) => (
              <a href={`#${h.slug}`} class={`toc-link toc-depth-${h.depth}`}>
                {h.text}
              </a>
            ))}
          </nav>
        </details>
      )
    }

    <!-- Main layout -->
    <div class="post-layout">
      <article class="post-content">
        <a href="/articles/" class="back-link btn btn-outline">← Back to articles</a>
        <div class="prose">
          <Content />
        </div>
      </article>

      <aside class="post-sidebar">
        {
          headings.length > 0 && (
            <div class="sidebar-section">
              <details open>
                <summary class="sidebar-heading">Contents</summary>
                <nav class="toc-nav">
                  <a
                    href="#post-title"
                    class="toc-link toc-depth-1 toc-link--active"
                  >
                    {post.data.title}
                  </a>
                  {headings.map((h) => (
                    <a
                      href={`#${h.slug}`}
                      class={`toc-link toc-depth-${h.depth}`}
                    >
                      {h.text}
                    </a>
                  ))}
                </nav>
              </details>
            </div>
          )
        }

        {
          relatedPosts.length > 0 && (
            <div class="sidebar-section">
              <h2 class="sidebar-heading">Related Posts</h2>
              <div class="related-posts">
                {relatedPosts.map((p) => (
                  <a href={`/posts/${p.id}/`} class="related-post">
                    {p.data.image && (
                      <div class="related-post-image">
                        <Image src={p.data.image.url} alt={p.data.image.alt} />
                      </div>
                    )}
                    <div class="related-post-body">
                      <span class="related-post-date">
                        {p.data.pubDate.toLocaleDateString()}
                      </span>
                      <p class="related-post-title">{p.data.title}</p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </aside>
    </div>

    <!-- Mobile related posts -->
    {
      relatedPosts.length > 0 && (
        <div class="related-mobile">
          <h2 class="sidebar-heading">Related Posts</h2>
          <div class="related-posts">
            {relatedPosts.map((p) => (
              <a href={`/posts/${p.id}/`} class="related-post">
                {p.data.image && (
                  <div class="related-post-image">
                    <Image src={p.data.image.url} alt={p.data.image.alt} />
                  </div>
                )}
                <div class="related-post-body">
                  <span class="related-post-date">
                    {p.data.pubDate.toLocaleDateString()}
                  </span>
                  <p class="related-post-title">{p.data.title}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  body {
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
      url("../../assets/bg.webp");
    background-size: cover;
    background-attachment: fixed;
    background-position: center;
  }

  body.theme-woodworking {
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
      url("../../assets/bg-wood.webp");
    background-size: cover;
    background-attachment: fixed;
    background-position: center;
  }

  body.theme-gardening {
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
      url("../../assets/bg-garden.webp");
    background-size: cover;
    background-attachment: fixed;
    background-position: center;
  }

  .post-page {
    max-width: var(--max-w);
    margin: 0 auto;
    margin-top: -64px; /* pull up behind header */
    padding: 1rem;
    padding-top: calc(2rem + 64px); /* compensate for the negative margin */
    background-color: var(--post-surface);
    background: linear-gradient(to right,rgba(0, 0, 0, 1) -150%,var(--post-surface),rgba(0, 0, 0, 1) 250%);
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.4), 10px 0 30px rgba(0, 0, 0, 0.4);
  }

  @media (min-width: 768px) {
    .post-page {
      border-left: 3px solid var(--post-border);
      border-right: 3px solid var(--post-border);
      padding: 2rem;
      padding-top: calc(2rem + 64px);
    }
  }

  /* ─── HEADER ─────────────────────────── */

  .post-hero-image {
    width: fit-content;
    margin: 0 auto;
    margin-bottom: 1rem;
  }

  .post-hero-image img {
    max-width: 100%;
    max-height: 400px;
    min-height: 400px;
    height: auto;
    width: auto;
    display: block;
    border-radius: 10px;
  }

  .post-hero-image a {
    display: inline;
  }

  .post-header-content h1 {
    font-family: var(--mono);
    color: var(--post-text);
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin-bottom: 0;
  }

  .post-meta {
    display: flex;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--post-text-muted);
    margin-bottom: 1rem;
  }

  .post-author a,
  .post-author a:visited {
    text-decoration: none;
    color: var(--blue-bright);
    font-weight: 700;
  }

  .post-author a:hover {
    color: white;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tag-pill {
    font-family: var(--mono);
    font-size: 0.75rem;
    background: var(--post-card);
    color: var(--post-text-sec);
    border: 1px solid var(--post-border);
    border-radius: 6px;
    padding: 0.25rem 0.6rem;
    text-decoration: none;
    transition:
      color 0.2s,
      border-color 0.2s,
      background 0.2s;
  }

  .tag-pill:hover {
    color: var(--blue-bright);
    border-color: var(--border-hover);
    background: var(--blue-dim);
  }

  /* ─── MOBILE TOC ─────────────────────── */

  .toc-mobile {
    background: var(--post-bg-card);
    border: 1px solid var(--post-border);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    margin-bottom: 2rem;
    font-family: var(--mono);
    font-size: 0.8rem;
  }

  .toc-mobile summary {
    cursor: pointer;
    color: var(--post-text-sec);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toc-mobile summary::before {
    content: "▶";
    font-size: 0.6rem;
    color: var(--blue-bright);
    transition: transform 0.2s;
  }

  .toc-mobile[open] summary::before {
    transform: rotate(90deg);
  }

  .toc-mobile .toc-nav {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  @media (min-width: 768px) {
    .toc-mobile {
      display: none;
    }
  }

  /* ─── LAYOUT ─────────────────────────── */

  .post-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 768px) {
    .post-layout {
      grid-template-columns: 1fr 280px;
    }
  }

  /* ─── CONTENT ────────────────────────── */

  .back-link {
    display: inline-flex;
    align-items: center;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--blue-bright);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--blue-bright);
  }

  .prose {
    color: var(--post-text-sec);
    line-height: 1.8;
    font-size: 1rem;
  }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    font-family: var(--mono);
    font-weight: 700;
    color: var(--post-text);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .prose :global(h2) {
    font-size: 1.4rem;
  }
  .prose :global(h3) {
    font-size: 1.15rem;
  }
  .prose :global(h4) {
    font-size: 1rem;
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
  }

  .prose :global(a) {
    color: var(--blue-bright);
    text-decoration: underline;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .prose :global(li) {
    margin-bottom: 0.35rem;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--blue);
    padding: 0.75rem 1.25rem;
    margin: 1.5rem 0;
    background: var(--post-card);
    border-radius: 0 8px 8px 0;
    font-style: italic;
    color: var(--post-text-sec);
  }

  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.85em;
    background: var(--post-card);
    color: var(--blue-bright);
    padding: 0.15em 0.35em;
    border-radius: 4px;
  }

  .prose :global(pre) {
    background: var(--bg) !important;
    border: 1px solid var(--post-border);
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
  }

  .prose :global(img) {
    max-width: 100%;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  .prose :global(.float-left) {
    float: left;
    width: 45%;
    height: auto;
    margin: 0 1.5rem 1rem 0;
  }

  .prose :global(.float-right) {
    float: right;
    width: 45%;
    height: auto;
    margin: 0 0 1rem 1.5rem;
  }

  .prose :global(.float-middle) {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.5rem 0;
  }

  /* clear floats after paragraphs so they don't bleed into next section */
  .prose :global(h2),
  .prose :global(h3) {
    clear: both;
  }

  @media (max-width: 768px) {
    .prose :global(.float-left),
    .prose :global(.float-right),
    .prose :global(.float-middle) {
      float: none;
      width: 100%;
      margin: 1rem 0;
    }
  }

  .prose :global(hr) {
    border: none;
    border-top: 3px solid var(--post-border);
    margin: 2rem 0;
  }

  /* ─── SIDEBAR ────────────────────────── */

  .post-sidebar {
    display: none;
  }

  @media (min-width: 768px) {
    .post-sidebar {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      position: sticky;
      top: 80px; /* just below header */
      max-height: calc(100vh - 100px);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--blue-bright) transparent;
      padding-right: 10px;
    }
  }

  .sidebar-section {
    background: var(--post-card);
    border: 1px solid var(--post-border);
    border-radius: 10px;
    padding: 1.25rem;
  }

  .sidebar-section details summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0;
  }

  .sidebar-section details summary::before {
    content: "▶";
    font-size: 0.55rem;
    color: var(--blue-bright);
    transition: transform 0.2s;
    flex-shrink: 0;
  }

  .sidebar-section details[open] summary::before {
    transform: rotate(90deg);
  }

  .sidebar-section details[open] .toc-nav {
    margin-top: 1rem;
  }

  .sidebar-heading {
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--post-text-muted);
    margin-bottom: 1rem;
  }

  /* ─── TOC ────────────────────────────── */

  .toc-nav {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .toc-link {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--post-text-sec);
    text-decoration: none;
    line-height: 1.4;
    transition: color 0.2s;
    padding: 0.1rem 0;
  }

  .toc-link:hover {
    color: var(--blue-bright);
  }

  .toc-depth-1 {
    padding-left: 0;
    font-weight: 600;
    color: var(--post-text);
  }

  .toc-depth-2 {
    padding-left: 0;
  }
  .toc-depth-3 {
    padding-left: 0.75rem;
  }
  .toc-depth-4 {
    padding-left: 1.5rem;
  }
  .toc-depth-5 {
    padding-left: 2.25rem;
  }
  .toc-depth-6 {
    padding-left: 3rem;
  }

  .toc-link--active {
    color: var(--blue-bright);
    font-weight: 500;
  }

  /* ─── RELATED POSTS ──────────────────── */

  .related-posts {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .related-post {
    display: flex;
    gap: 0.75rem;
    text-decoration: none;
    align-items: center;
    transition: opacity 0.2s;
  }

  .related-post:hover {
    opacity: 0.75;
  }

  .related-post-image img {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
    display: block;
  }

  .related-post-date {
    font-family: var(--mono);
    font-size: 0.65rem;
    color: var(--post-text-muted);
    display: block;
    margin-bottom: 0.2rem;
  }

  .related-post-title {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--post-text);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-mobile {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .related-mobile .sidebar-heading {
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--post-text-muted);
    margin-bottom: 1rem;
  }

  .related-mobile .related-posts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .related-mobile .related-post {
    flex-direction: column;
    align-items: flex-start;
  }

  .related-mobile .related-post-image img {
    width: 100%;
    height: 100px;
    border-radius: 8px;
  }

  @media (min-width: 768px) {
    .related-mobile {
      display: none;
    }
  }
</style>

<script>
  import "../../scripts/scrollspy-toc.js";
</script>
