---
// /sites/praxisproject/src/pages/index.astro
import { getCollection } from "astro:content";
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import BlogPost from '../components/BlogPost.astro';

const recentPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const pageTitle = "Home";
---
<BaseLayout pageTitle={pageTitle} pagefindIgnore={true}>

  <Card>
    <p>Welcome message goes here.</p>
    <br />
    <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Fusce iaculis consequat velit in interdum. Mauris ultrices sapien mauris, a sollicitudin magna sollicitudin et. Proin semper fermentum lacus, sit amet hendrerit libero aliquam non. Nunc ac auctor dolor. Nullam ut massa ligula. Vivamus mi turpis, mattis eget vulputate vel, aliquet vel elit. Suspendisse potenti. Nam porta egestas libero id dignissim.</p>
  </Card>

  <Card>
    <h2 style="text-align: center;">Recent Posts</h2>
    <div class="recent-posts">
      {recentPosts.map((post) => (
        <BlogPost
        url={`/posts/${post.id}/`}
        title={post.data.title}
        image={post.data.image}
        pubDate={post.data.pubDate}
      />
      ))}
    </div>
  </Card>

</BaseLayout>

<style>
  .recent-posts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: start;
  }

  @media screen and (min-width: 768px) {
    .recent-posts {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
</style>