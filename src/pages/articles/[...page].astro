---
// praxisproject/src/pages/articles/[...page].astro
import PostListLayout from "../../layouts/ArticleListLayout.astro";
import TagCloud from "../../components/TagCloud.astro";
import {
  getAllPosts,
  getTagCounts,
  getSortedTags,
} from "../../scripts/articleData.ts";
import type { Page } from "astro";

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const allPosts = await getAllPosts();
  return paginate(allPosts, { pageSize: 10 });
}

const { page } = Astro.props as { page: Page<any> };
const tagCounts = await getTagCounts();
const tags = getSortedTags(tagCounts);
const pageTitle = `Articles — Page ${page.currentPage}`;
---

<PostListLayout {page} {pageTitle}>
  <div slot="header">
    <h2>All Articles</h2>
    <h3>Browse Posts by Tag</h3>

    {/* Tags sized by post frequency — no active highlight */}
    <TagCloud tags={tags} showTiers={true} />

    <p class="post-count">
      {page.total}
      {page.total === 1 ? "article" : "articles"}
    </p>
  </div>
</PostListLayout>

<style>
  body {
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
      url("../../assets/bg.webp");
    background-size: cover;
    background-attachment: fixed;
    background-position: center;
  }
</style>
